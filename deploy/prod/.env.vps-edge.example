APP_SERVICE_NAME=secret-letter-api
APP_ENV=production
ALLOWED_ORIGIN=https://secret.quorix.io.vn
# Keep this scoped to the final hop that reaches the API container.
TRUSTED_PROXY_CIDRS=172.16.0.0/12

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_CREATE_PER_WINDOW=120
RATE_LIMIT_CONSUME_PER_WINDOW=240
RATE_LIMIT_STATUS_PER_WINDOW=600
RATE_LIMIT_REVEAL_SESSION_PER_WINDOW=240

REDIS_PASSWORD=replace-with-long-random-redis-password
REDIS_DB=0
REDIS_POOL_SIZE=50
REDIS_MIN_IDLE=10
REDIS_MAX_RETRIES=3

# Generate once and keep stable across restarts:
# openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
SECRET_ENCRYPTION_KEY=replace-with-stable-base64url-32-byte-key
