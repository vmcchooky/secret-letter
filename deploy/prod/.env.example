# General Configuration
APP_SERVICE_NAME=one-time-link-api
APP_ENV=production
ALLOWED_ORIGIN=https://secret.quorix.io.vn
TRUSTED_PROXY_CIDRS=172.16.0.0/12

# Redis Configuration
# Set a strong, unique password for Redis authentication
REDIS_PASSWORD=set_a_very_long_secure_random_password_here
REDIS_DB=0
REDIS_POOL_SIZE=50
REDIS_MIN_IDLE=10
REDIS_MAX_RETRIES=3

# Secret Encryption
# Generate once and keep stable across restarts:
# openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
SECRET_ENCRYPTION_KEY=generate_a_stable_32_byte_base64url_key_here
